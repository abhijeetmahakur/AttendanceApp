SECRET_KEY=change-this-to-a-random-secret
DATABASE_PATH=instance/attendance.db

# Default admin account, created automatically on first run
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# Attendance threshold (percentage) below which low-attendance warnings are sent
ATTENDANCE_THRESHOLD=75
# Minimum attendance (percentage) required to be eligible to sit exams
EXAM_ELIGIBILITY_THRESHOLD=33

# Where uploaded leave-request attachments are stored, and the max file size allowed
UPLOAD_FOLDER=instance/uploads
MAX_ATTACHMENT_SIZE_MB=5

# S3-compatible cloud storage (Cloudflare R2, AWS S3, Backblaze B2, ...) for
# leave-request attachments. Leave blank to save attachments to local disk
# instead (instance/uploads) - fine for local development, but most hosts
# only keep local files across redeploys if you pay for a persistent disk.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Shown as the header on generated PDF attendance reports
COLLEGE_NAME=Attendance Management System

# Default duration (minutes) pre-selected when an admin generates an attendance QR code
QR_DEFAULT_DURATION_MINUTES=5

# SMTP settings used to email students their attendance summary.
# For Gmail: enable 2FA on the account, then create an "App Password"
# at https://myaccount.google.com/apppasswords and use it as MAIL_PASSWORD.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# WhatsApp (Twilio WhatsApp API) settings used for absentee alerts and
# holiday/substitution notices. Get these from a Twilio account:
# https://console.twilio.com (Account SID + Auth Token) and the WhatsApp
# sender number assigned to that account (sandbox or approved sender).
# Leave blank to have WhatsApp messages logged to the console instead of
# actually sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
